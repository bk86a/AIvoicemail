#!/bin/sh
# Run the aivoicemail CLI inside the worker image ("tools" service: host network, config/, generated/).
#   ./aivm check | generate | render-prompts | test-call
# `test-call` alone runs in the separate "testcall" service (it needs a raw socket for SIPp's RTP
# port range checks; "tools" and "worker" never get one). Split mode (processing host):
# AIVM_COMPOSE=deploy/compose.worker.yaml ./aivm check
set -eu
cd "$(dirname "$0")"
[ -f .env ] && [ -n "$(find .env -prune -perm -004)" ] && echo "WARNING: .env is world-readable; run: chmod 600 .env" >&2
if [ "${1:-}" = "test-call" ]; then
  shift
  exec docker compose -f "${AIVM_COMPOSE:-compose.yaml}" run --rm testcall "$@"
fi
exec docker compose -f "${AIVM_COMPOSE:-compose.yaml}" run --rm tools "$@"
